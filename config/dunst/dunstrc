# minimal dwm notifications — short-lived, no sticky junk
[global]
    monitor = 0
    follow = keyboard
    width = (0, 360)
    height = (0, 240)
    origin = top-right
    offset = (12, 36)
    scale = 0
    notification_limit = 3
    progress_bar = true
    progress_bar_height = 2
    progress_bar_frame_width = 0
    progress_bar_min_width = 150
    progress_bar_max_width = 360
    indicate_hidden = yes
    transparency = 0
    separator_height = 1
    padding = 10
    horizontal_padding = 12
    text_icon_padding = 8
    frame_width = 1
    frame_color = "#d0d0d0"
    gap_size = 6
    separator_color = frame
    sort = yes
    idle_threshold = 0
    font = JetBrainsMono Nerd Font Mono 10
    line_height = 0
    markup = full
    format = "<b>%s</b>\n%b"
    alignment = left
    vertical_alignment = center
    show_age_threshold = -1
    ellipsize = end
    ignore_newline = no
    stack_duplicates = true
    hide_duplicate_count = true
    show_indicators = no
    enable_recursive_icon_lookup = true
    icon_position = left
    min_icon_size = 24
    max_icon_size = 48
    sticky_history = no
    history_length = 5
    browser = /home/ryuzaki/.local/bin/firefox
    always_run_script = false
    title = Dunst
    class = Dunst
    corner_radius = 0
    mouse_left_click = do_action, close_current
    mouse_middle_click = close_current
    mouse_right_click = close_all
    dmenu = /usr/bin/dmenu -l 10 -p action

[experimental]
    per_monitor_dpi = false

[urgency_low]
    background = "#000000"
    foreground = "#9a9a9a"
    frame_color = "#222222"
    timeout = 3

[urgency_normal]
    background = "#000000"
    foreground = "#f2f2f2"
    frame_color = "#d0d0d0"
    timeout = 4

[urgency_critical]
    background = "#140808"
    foreground = "#f2f2f2"
    frame_color = "#ff6b6b"
    timeout = 6

# Telegram → compact toast
[telegram]
    appname = "Telegram*"
    summary = "*"
    format = "<b>%s</b>\n%b"
    timeout = 4
    background = "#000000"
    foreground = "#f2f2f2"
    frame_color = "#d0d0d0"

# Mullvad / VPN spam — blink and die
[mullvad]
    appname = "Mullvad*"
    timeout = 2
    background = "#000000"
    foreground = "#f2f2f2"
    frame_color = "#222222"
